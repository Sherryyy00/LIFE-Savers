# Copy to .env for local development. NEVER commit .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite locally. Neon example:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Production only
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# ADMIN_URL=some-hard-to-guess-path/

# Donation rules (defaults shown, confirm with a local blood bank)
# DONATION_INTERVAL_DAYS=90
# DONOR_MIN_AGE=18
# DONOR_MAX_AGE=60
# DEFAULT_MATCH_RADIUS_KM=15
